# Binance Web3 API (developer portal)
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=
BINANCE_WEB3_BASE_URL=https://web3.binance.com/build

# BNB Smart Chain
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Independent reference quotes (recommended; see SPEC 3.4)
FINNHUB_API_KEY=

# Off-Hours Tape
TAPE_DB_PATH=./data/tape.sqlite
TAPE_INTERVAL_SEC=300
TAPE_QUOTE_WALLET=                # public address of the hot wallet; RFQ quotes (Ondo, bStocks) need a receiver

# Execution: dedicated hot wallet only, never a personal wallet
EXEC_MODE=preview                 # preview | agentic-wallet | direct
EXEC_MAX_USD_PER_TRADE=25
DIRECT_SIGNER_PRIVATE_KEY=        # only used when EXEC_MODE=direct
